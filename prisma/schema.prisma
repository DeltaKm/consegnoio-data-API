
// Index:
//  objType    r17  
//  enumType   r85   
//  dataModel  r127

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


// ***** Inizio objType *****
type CordType {
  lat Float
  long Float
}

type DatiFiscaliType {
  codiceFisclale String
  ragioneSociale String
  partitaIVA String
  codiceSDI String
  pec String
}

type IndirizzoType {
  via String
  numeroCivio String
  provincia String
  provinciaSigla String
  citta String
  cap Int
}

type AnagraficaUserType {
  nome String
  cognome String
  domicilio IndirizzoType
  residenza IndirizzoType 
  cittadinanza CittadinanzaEnum
  fiscalita DatiFiscaliType
  tel String
}

type PosMapType {
  coordinate CordType
  indirizzo IndirizzoType
  }

type CostoType {
  pagamentoAllaConsegna Boolean
  quota Float
}

type DatiMerceType {
  tipoMerce CategoriaMerceEnum
  nome String
  peso Float
  altezza Float
  larghezza Float
  lunghezza Float
  densita Float
  pesoVolumetrico Float
}

type PreferenzeZonaRaiderType {
  zoneConsegna String[]
  distanzaKM Int
}

// prototipo
type WorkTime {
  data DateTime
  oreTotali Float
}

// ----- INIZIO DistanceMatrixType vTEST ----
type Distance {
  text String
  value Float
}

type Duration {
  text String
  value Float
}
//unitParam: imperial= miles / yard, metric=km / meters
type DistanceMatrixType {
  destinazione String
  origine String
  distanza Distance
  durata Duration
  status String
}
// ----- FINE DistanceMatrixType vTEST  ----
// ***** Fine objType *****



// ***** Inizio enumType *****
enum StatusCodes {
  NotFound 
 
}
enum CittadinanzaEnum {
  Italiana
  Estera
}

enum CategoriaMerceEnum {
  Alimentare
  MaterialiVari
}

enum StatoDisponibilitaEnum {
  Disponibile
  Occupato
}

enum MetodoConsegnaEnum {
  Bici  
  Auto
  SenzaVeicolo
}

enum RuoloEnum {
  Raider 
  Contractor
  RaiderContractor
}

enum StatoConsegnaEnum {
  daRitirare
  inConsegna
  Consegnato
  Cancellato
}
// ***** Fine enumType *****



// ***** Inizio dataModel *****
model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    idSlug String
    email String 
    username String 
    password String
    role RuoloEnum
    raiderId Raider?
    contractorId Contractor?    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@unique([idSlug, email, username]) 
}

model Raider{
    id String @id @default(auto()) @map("_id") @db.ObjectId
    user User @relation(fields: [userId], references: [id])
    userId String @unique @db.ObjectId    
    metodo MetodoConsegnaEnum
    stato StatoDisponibilitaEnum
    preferenze PreferenzeZonaRaiderType
    isOnWorkFlag Boolean // attivo se il raider ha preso in carico una consegna
    raiderPosition CordType
    storicoConsegne String[] // add reference to Delivery 
    workTime Float //da definire per i filtri
    preferiti String[] 
    blacklist String[]
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt    
}

model Contractor {
      id String @id @default(auto()) @map("_id") @db.ObjectId
      user User @relation(fields: [userId], references: [id])
      userId String @unique @db.ObjectId
      orderId Order?
      posizioneSede PosMapType[] // indirizzi sede
      storicoConsegne String[] // add reference to Delivery
      preferiti String[]
      blacklist String[]
      createdAt DateTime @default(now())
      updatedAt DateTime @updatedAt            
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  user Contractor @relation(fields: [contractorId], references: [id])
  contractorId String @unique @db.ObjectId
  hashQrFirma String
  dataOreRitiroPrevisto DateTime
  dataOreConsegnaPrevista DateTime
  indirizzoRitiro PosMapType
  indirizzoConsegna PosMapType
  note String
  quotaRaider Float
  quota CostoType
  identificaitvoMerce DatiMerceType
  isActive Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  }

  model Delivery {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    raiderID String // add reference to Raider 
    ordine String // add reference to Order 
    stato StatoConsegnaEnum
    dataOraRitiroReale DateTime
    dataOraConsegnaReale DateTime
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }

  model GooglePosMap {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    placeId String @unique
    indirizzo PosMapType 
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }

  
  model DeletedDelivery {
        id String @id @default(auto()) @map("_id") @db.ObjectId
        fromID String // add reference to User
        fromRuolo RuoloEnum 
        createdAt DateTime @default(now())
        updateAt DateTime @updatedAt 
  }

  
  model DeletedOrder {
        id String @id @default(auto()) @map("_id") @db.ObjectId
        contractorID String // add reference to Contractor
        createdAt DateTime @default(now())
        updateAt DateTime @updatedAt
  }

  // prototipo
  model StoricoConsegne {
     id String @id @default(auto()) @map("_id") @db.ObjectId 
     idDelivery String[] // // add reference to Delivery
     createdAt DateTime @default(now())
     updateAt DateTime @updatedAt
  }


  model Comuni {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    codiceIstat String
    denominazioneIta String
    cap String
    siglaProvincia String
    denominazioneProvincia String
    denominazioneRegione String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }

  model Nazioni {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    siglaNazione String
    codiceBelfiore String
    denominazioneNazione String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }

  // prototipo
  model RaiderWorkTime {
        id String @id @default(auto()) @map("_id") @db.ObjectId
        hours WorkTime    
  }

  // prototipo google DistanceMatrix => wsRouteDistance
  model DistanceMatrix {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    matrix DistanceMatrixType
  }
// ***** Fine dataModel *****


