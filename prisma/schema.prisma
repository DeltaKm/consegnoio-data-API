generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================
// ========================== User =============================
// =============================================================

model User {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  email                   String    @unique
  password                String?
  role                    RoleEnum? @default(USER)
  confirmed               Boolean   @default(false)
  confirmationToken       String?
  resetPasswordToken      String?
  resetPasswordExpiration DateTime?
  tokenJWT                String?
  expirationJWT           DateTime? // da testare
  expired                 Boolean?
  imgUrl                  String    @default("asset/immages/log-consegnoio.png")
  creatdeAt               DateTime  @default(now())
  updateAt                DateTime  @updatedAt
}

//da definire con zod per i problemi di prisma fare prima il test perche puo essere un problema solo sullo schema precedente
enum RoleEnum {
  ADMIN
  USER
  LOGISTICS
  BUSINESS
  RAIDER
}

// =============================================================

// =============================================================
// ========================= Raider ============================
// =============================================================

model Raider {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  userId          String      @db.ObjectId // reference to user
  isActive        Boolean
  bussinesActived String[]    @default([]) // reference 
  inService       Boolean     @default(false) // flag per attivare la modalita raider on
  vehicle         veichleEnum @default(CAR)
  createdAt       DateTime    @default(now())
  updateAt        DateTime    @updatedAt
}

enum veichleEnum {
  CAR
  BICYCLE
  MOTORCYCLE
}

// =============================================================

// =============================================================
// ======================== Business ===========================
// =============================================================

model Business {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  dataBussines String
  address      String[]
  createdAt    DateTime @default(now())
  updateAt     DateTime @updatedAt
}

// =============================================================

// =============================================================
// ================= ServerApiKeyManagement ====================
// =============================================================

model ServerApiKeyManagement {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  bussinesId     String // reference
  assigendApiKey String
  isActive       Boolean  @default(false)
  creatdAt       DateTime @default(now())
  updateAt       DateTime @updatedAt
}

