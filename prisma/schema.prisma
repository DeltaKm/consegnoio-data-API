generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================
// ========================== User =============================
// =============================================================

model User {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  email                   String    @unique
  password                String?
  role                    RoleEnum? @default(USER)
  confirmed               Boolean   @default(false)
  confirmationToken       String?
  resetPasswordToken      String?
  resetPasswordExpiration DateTime?
  tokenJWT                String?
  expirationJWT           DateTime? // da testare
  expired                 Boolean?
  imgUrl                  String    @default("asset/immages/log-consegnoio.png")
  creatdeAt               DateTime  @default(now())
  updateAt                DateTime  @updatedAt

  raiderProfiles   Raider[]   @relation("UserRaider")
  businessProfiles Business[] @relation("UserBusiness")
}

//da definire con zod per i problemi di prisma fare prima il test perche puo essere un problema solo sullo schema precedente
enum RoleEnum {
  ADMIN
  USER
  LOGISTICS
  BUSINESS
  RAIDER
}

// =============================================================

// =============================================================
// ========================= Raider ============================
// =============================================================

model Raider {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  surname         String
  isActive        Boolean     @default(false)
  bussinesActived String[]    @default([]) // reference 
  inService       Boolean     @default(false) // flag per attivare la modalita raider on
  vehicle         veichleEnum @default(CAR)
  createdAt       DateTime    @default(now())
  updateAt        DateTime    @updatedAt

  user User? @relation("UserRaider", fields: [userId], references: [id])

  businessRelations BusinessRaider[]
  userId            String?          @db.ObjectId
}

enum veichleEnum {
  CAR
  BICYCLE
  MOTORCYCLE
  VAN
  REFRIGERATEDVAN
  WITHOUTVEHICLE
  TRANSIT
}

// valutare se validare le modlità da inviare per calcolare le distanze
// se inserile lato db, o validare lato backend
enum googleTravelMode {
  driving // (default) indica le direzioni di guida standard o la distanza utilizzando la rete stradale
  walking // indicazioni stradali o distanza tramite percorsi pedonali e marciapiedi (ove disponibili).
  bicycling // indicazioni in bicicletta o distanza tramite piste ciclabili e strade preferite
  transit // struzioni per le richieste di transito o distanza utilizzando le rotte di trasporto pubblico (ove disponibili)
  transit_routing_preference // Se si imposta la modalità di transito, è possibile specificare facoltativamente un orario di partenza o un orario di arrivo. Se non viene specificato alcun orario, l'ora di partenza è predefinita ora (ovvero, l'orario di partenza è predefinito all'ora corrente). È inoltre possibile includere facoltativamente una modalità transit_ e / o una preferenza transit_routing_.
}

// =============================================================

// =============================================================
// ======================== Business ===========================
// =============================================================

model Business {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  bussinesName  String
  raiderActived String[]
  address       String
  createdAt     DateTime @default(now())
  updateAt      DateTime @updatedAt

  user User? @relation("UserBusiness", fields: [userId], references: [id])

  raiderRelations BusinessRaider[]
  userId          String?          @db.ObjectId
}

// =============================================================

model BusinessRaider {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  business              Business @relation(fields: [businessId], references: [id])
  businessId            String   @db.ObjectId
  raider                Raider   @relation(fields: [raiderId], references: [id])
  raiderId              String   @db.ObjectId
  confirmedFromBusiness Boolean  @default(false)
  createdAt             DateTime @default(now())
  updateAt              DateTime @updatedAt

  @@unique([businessId, raiderId])
}

