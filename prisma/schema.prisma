
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Index:
//  objType    r17  
//  enumType   r79   
//  dataModel  r112   


// ***** Inizio objType *****
type CordType {
  lat Float
  long Float
}

type DatiFiscaliType {
  codiceFisclale String
  ragioneSociale String
  partitaIva String
  codiceSDI String
  pec String
}

type IndirizzoType {
  via String
  numero Int
  provincia String
  citta String
  cap Int
}

type AnagraficaUserType {
  nome String
  cognome String
  domicilio IndirizzoType
  residenza IndirizzoType 
  cittadinanza CittadinanzaEnum
  fiscalita DatiFiscaliType
  email String
  tel String
}

// merge in AnagraficaUserType
type AnagraficaRaiderType {   
  nome String
  cognome String
  dataNascita DateTime
  codiceFisclale String
  via String
  provincia String
  citta String
  cap Int
  tel String
}

// merge in AnagraficaUserType
type AnagraficaContractorType {   
  nome String
  cognome String
  dataNascita DateTime
  codiceFiscla String
  via String
  denominazioneProvincia String
  siglaProvincia String
  citta String
  cap Int
  tel String
  sede PosizioneContractorType[]
}

type PosizioneContractorType {
  coordinate CordType
  via String
  provincia String
  citta String
  cap String
  nomeAttivita String
  partitaIva String
  codiceFiscleAttivita String
  }

type CostoType {
  pagamentoAllaConsegna Boolean
  quota Float
}

type DatiMerceType {
  tipoMerce CategoriaMerceEnum
  nome String
  volume Float
  peso Float
}

type PreferenzeRaiderType {
  zoneConsegna String[]
  distanzaKM Int
}
// ***** Fine objType *****



// ***** Inizio enumType *****
enum CittadinanzaEnum {
  Italiana
  Estera
}

enum CategoriaMerceEnum {
  Alimentare
  MaterialiVari
}

enum StatoDisponibilitaEnum {
  Disponibile
  Occupato
}

enum MetodoConsegnaEnum {
  Bici  
  Auto
  SenzaVeicolo
}

enum RuoloEnum {
  Raider 
  CategoriaMerceontractor
  RaiderContractor
}

enum StatoConsegnaEnum {
  daRitirare
  inConsegna
  Consegnato
  Cancellato
}
// ***** Fine enumType *****



// ***** Inizio dataModel *****
model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    idSlug String
    email String 
    username String 
    password String
    role RuoloEnum
    raiderId Raider?
    contractorId Contractor?
    orderId Order?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@unique([idSlug, email, username]) 
}

model Raider{
    id String @id @default(auto()) @map("_id") @db.ObjectId
    user User @relation(fields: [userId], references: [id])
    userId String @unique @db.ObjectId    
    anagrafica AnagraficaRaiderType
    metodo MetodoConsegnaEnum
    stato StatoDisponibilitaEnum
    preferenze PreferenzeRaiderType
    raiderPosition CordType
    storicoConsegne String[] //reference Delivery da aggiungere
    workTime Float
    preferiti String[] 
    blacklist String[]
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt    
}

model Contractor {
      id String @id @default(auto()) @map("_id") @db.ObjectId
      user User @relation(fields: [userId], references: [id])
      userId String @unique @db.ObjectId
      anagrafica AnagraficaContractorType
      attivita PosizioneContractorType[]
      storicoConsegne String[] //reference Delivery - da aggiungere
      preferiti String[]
      blacklist String[]
      createdAt DateTime @default(now())
      updatedAt DateTime @updatedAt            
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  user User @relation(fields: [userId], references: [id])
  userId String @unique @db.ObjectId
  hashQrFirma String
  dataRitiro DateTime
  dataConsegna DateTime
  note String
  quotaRaider Float
  quota CostoType
  identificaitvoMerce DatiMerceType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  }

  model Delivery {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    raiderID String //reference Raider da aggiungere
    ordine String //reference Order da aggiungere
    stato StatoConsegnaEnum
    oraRitiro DateTime
    oraConsegna DateTime
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }

  model Comuni {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    codiceIstat Int
    denominazioneIta String
    cap Int
    siglaProvincia String
    denominazioneProvincia String
    denominazioneRegione String
    coordinate CordType
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }

  model Nazioni {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    siglaNazionale String
    codiceBelfiore String
    denominazioneNazionale String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }
// ***** Fine dataModel *****


