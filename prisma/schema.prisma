generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================
// ========================== User =============================
// =============================================================

// da aggiungere field per jwt valido anche per la dashboard
// da aggiungere i ruoli
// model User {
//   id        String   @id @default(auto()) @map("_id") @db.ObjectId
//   email     String   @unique
//   password  String
//   creatdeAt DateTime @default(now())
