// =============================================================
// ====================== TestDelivery =========================
// =============================================================

// da aggiungere id business e id cooperativa
// da valutare tutti i campo  della consegna 
// da implementare stato consegna sia backend che frontend

model testDelivery {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String? // business name valutare se inserire id easy appear e crare un type con nome e ideasy appear
  pickupAddress   String?
  deliveryAddress String?
  totalDistance   String?
  deliveryType    String?
  peso            Float?
  numeroColli     Int?
  compensation    Float?
  isAssigned      Boolean? @default(false)
  isCompleted     Boolean? @default(false)
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
}

// schema da implementare
model Delivery {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String? // reference to business name
  pickupAddress    String?
  deliveryAddress  String?
  totalDistance    String? // calcolata con google maps
  deliveryCategory CategoryDelivery @relation(fields: [categoryId], references: [id])
  categoryId       String           @unique @db.ObjectId // categoria tipologia prodotto
  peso             Float? // peso merce
  numeroColli      Int?
  compensation     Float? // compenso raider
  status           statusEnum // stato consegna
  isAssiged        Boolean?         @default(false)
  isCompleted      Boolean?         @default(false)
  createdAt        DateTime         @default(now())
  updateAt         DateTime         @updatedAt
}

model CategoryDelivery {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  delivery  Delivery[]
  category  String[]   @default(["Surgelati", "Alimenti"]) // da testare
  createdAt DateTime   @default(now())
  updateAt  DateTime   @updatedAt
}

// probaiblmente da rimuovere
// prototipo, da valutare in base ai dati forniti e se ha utilità
type businessType {
  easyAppearId String
  name         String
}

// prototitopo 
type deliveryStatus {
  status    statusEnum
  isDeleted Boolean
}

// stato della consegna
enum statusEnum {
  notAssigned
  onDelivery
  delivered
}

