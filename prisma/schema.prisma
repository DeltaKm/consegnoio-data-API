/**
 * - schema da implementare
 * - dopo la demo vanno inseriti i seguenti campi:
 * Quanto paga il desitnatario
 * se paga alla consegna o gia pagato
 * e verificare gli altri campi
 */
model Delivery {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  bussinessID      String? // reference to business name
  pickupAddress    String?
  deliveryAddress  String?
  totalDistance    String? // calcolata con google maps
  // *** da valutare se category va gestita in questo modo
  // infase iniziale potrei sosituirlo con la soluzione 
  // in testDelivery con il campo string deliveryType mapapto con ZOD
  deliveryCategory CategoryDelivery @relation(fields: [categoryId], references: [id])
  categoryId       String           @unique @db.ObjectId // categoria tipologia prodotto
  // **********************************************
  peso             Float? // peso merce in KG
  numeroColli      Int?
  compensation     Float? // compenso raider
  status           StatusEnum       @default(CREATED) // stato consegna nda trovare una soluzione per gl ienum
  isAssiged        Boolean?         @default(false)
  isCompleted      Boolean?         @default(false)
  createdAt        DateTime         @default(now())
  updateAt         DateTime         @updatedAt
}

// da verificare se i reference sono corretti
model CategoryDelivery {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  delivery  Delivery[]
  label     String
  value     String
  createdAt DateTime   @default(now())
  updateAt  DateTime   @updatedAt
}

