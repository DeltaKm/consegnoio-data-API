// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================
// ========================== User =============================
// =============================================================

// da aggiungere field per jwt valido anche per la dashboard
// da aggiungere i ruoli
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  creatdeAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

// da implementare verificare il funzionamento degli enum con role
model UserToImp {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  password      String?
  role          RoleEnum
  tokenJWT      String?
  expirationJWT DateTime? // da testare
  expirid       Boolean?
  imgUrl        String    @default("asset/immages/log-consegnoio.png")
  creatdeAt     DateTime  @default(now())
  updateAt      DateTime  @updatedAt
}

enum RoleEnum {
  ADMIN
  USER
  LOGISTICS
  BUSINESS
  RAIDER
}

// =============================================================


// =============================================================
// ========================= Raider ============================
// =============================================================

model Raider {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId // reference to user
  inService         Boolean  @default(false) // flag per attivare la modalita raider on
  vehicle           veichleEnum // enum con quale mezzo di trasporto usa
  businessWhitelist String[] @db.ObjectId // reference to bussiness id
  businessBlacklist String[] @db.ObjectId // refference to business id
  createdAt         DateTime @default(now())
  updateAt          DateTime @updatedAt
}

enum veichleEnum {
  CAR
  BICYCLE
  MOTORCYCLE
}

// =============================================================


// =============================================================
// ======================== Business ===========================
// =============================================================


model Business {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId // reference to user
  name            String
  dataBussines    String   // da definire i dati per l' attività
  address         String[] // da definire il componente google
  raiderWhitelist String[] @db.ObjectId //reference to raider id
  raiderBlacklist String[] @db.ObjectId //reference to raider id 
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
}

// =============================================================



// =============================================================
// ====================== TestDelivery =========================
// =============================================================

// da aggiungere id business e id cooperativa
// da valutare tutti i campo  della consegna 
// da implementare stato consegna sia backend che frontend

model testDelivery {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String? // business name valutare se inserire id easy appear e crare un type con nome e ideasy appear
  pickupAddress   String?
  deliveryAddress String?
  totalDistance   String?
  deliveryType    String?
  peso            Float?
  numeroColli     Int?
  compensation    Float?
  isAssigned      Boolean? @default(false)
  isCompleted     Boolean? @default(false)
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
}

// schema da implementare
model Delivery {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  name            String? // reference to business name
  pickupAddress   String?
  deliveryAddress String?
  totalDistance   String? // calcolata con google maps
  deliveryType    String? // categoria tipologia prodotto
  peso            Float? // peso merce
  numeroCollit    Int?
  compensation    Float? // compenso raider
  status          statusEnum // stato consegna
  isAssiged       Boolean?   @default(false)
  isCompleted     Boolean?   @default(false)
  createdAt       DateTime   @default(now())
  updateAt        DateTime   @updatedAt
}

// prototipo, da valutare in base ai dati forniti e se ha utilità
type businessType {
  easyAppearId String
  name         String
}

// prototitopo 
type deliveryStatus {
  status    statusEnum
  isDeleted Boolean
}

// stato della consegna
enum statusEnum {
  notAssigned
  onDelivery
  delivered
}

// =============================================================

// prototipo
model AassignedDelivery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  idDelivery String   @db.ObjectId // reference
  idRaider   String   @db.ObjectId // reference
  createdAt  DateTime @default(now())
  updateAt   DateTime @updatedAt
}

// prototipo
model HistoryDelivery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  idDelivery String   @db.ObjectId // reference
  idRaider   String   @db.ObjectId // reference
  createdAt  DateTime @default(now())
  updateAt   DateTime @updatedAt
}

model CancelledDeliveries {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  isAssigend Boolean // per valutare se era stata assegnata nel momento della cancellazione
  userId     String   @db.ObjectId // reference to user
  createdAt  DateTime @default(now())
  updateAt   DateTime @updatedAt
}

type GoogleAddressComponentType {
  placeId String
  address String
  lat     Float
  long    Float
}
