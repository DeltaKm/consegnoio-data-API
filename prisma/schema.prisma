// prototipo
model HistoryDelivery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  idDelivery String   @db.ObjectId // reference
  idRaider   String   @db.ObjectId // reference
  createdAt  DateTime @default(now())
  updateAt   DateTime @updatedAt
}

model CancelledDeliveries {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId // reference to user diretto poi si valuta se era raider o business
  note      String
  status    String // lo stato in cui la consegna era quando è stata cancellata
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

