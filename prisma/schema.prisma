
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Index:
//  objType    r17  
//  enumType   r79   
//  dataModel  r112   


// ***** Inizio objType *****
type Cord {
  lat Float
  long Float
}

type AnagraficaRaiderType {   
  nome String
  cognome String
  dataNascita DateTime
  codiceFiscla String
  via String
  provincia String
  citta String
  cap Int
  tel String
}

type AnagraficaContractorType {   
  nome String
  cognome String
  dataNascita DateTime
  codiceFiscla String
  via String
  provincia String
  citta String
  cap Int
  tel String
  sede PosizioneContractor[]
}

type PosizioneContractor {
  coordinate Cord
  via String
  provincia String
  citta String
  cap String
  nomeAttivita String
  partitaIva String
  codiceFiscleAttivita String
  }

type Costo {
  pagamentoAllaConsegna Boolean
  quota Float
}

type DatiMerce {
  tipoMerce CategoriaMerce
  nome String
  volume Float
  peso Float
}

type PreferenzeRaider {
  zoneConsegna String[]
  distanzaKM Int
}
// ***** Fine objType *****



// ***** Inizio enumType *****
enum CategoriaMerce {
  alimentare
  materialiVari
}

enum StatoDisponibilita {
  disponibile
  occupato
}

enum MetodoConsegna {
  bici  
  auto
  senzaVeicolo
}

enum Ruolo {
  raider 
  contractor
  raiderContractor
}

enum statoConsegna {
  daRitirare
  inConsegna
  consegnato
  cancellato
}
// ***** Fine enumType *****



// ***** Inizio dataModel *****
model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    idSlug String
    email String 
    username String 
    password String
    role Ruolo
    raiderId Raider?
    contractorId Contractor?
    orderId Order?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@unique([idSlug, email, username]) 
}

model Raider{
    id String @id @default(auto()) @map("_id") @db.ObjectId
    user User @relation(fields: [userId], references: [id])
    userId String @unique @db.ObjectId    
    anagrafica AnagraficaRaiderType
    metodo MetodoConsegna
    stato StatoDisponibilita
    preferenze PreferenzeRaider
    raiderPosition Cord
    storicoConsegne String[] //reference Delivery da aggiungere
    workTime Float
    preferiti String[] 
    blacklist String[]
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt    
}

model Contractor {
      id String @id @default(auto()) @map("_id") @db.ObjectId
      user User @relation(fields: [userId], references: [id])
      userId String @unique @db.ObjectId
      anagrafica AnagraficaContractorType
      attivita PosizioneContractor[]
      storicoConsegne String[] //reference Delivery - da aggiungere
      preferiti String[]
      blacklist String[]
      createdAt DateTime @default(now())
      updatedAt DateTime @updatedAt            
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  user User @relation(fields: [userId], references: [id])
  userId String @unique @db.ObjectId
  hashQrFirma String
  dataRitiro DateTime
  dataConsegna DateTime
  note String
  quotaRaider Float
  quota Costo
  identificaitvoMerce DatiMerce
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  }

  model Delivery {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    raiderID String //reference Raider da aggiungere
    ordine String //reference Order da aggiungere
    stato statoConsegna
    oraRitiro DateTime
    oraConsegna DateTime
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }

  model Comuni {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    codiceIstat Int
    denominazioneIta String
    cap Int
    siglaProvincia String
    denominazioneProvincia String
    denominazioneRegione String
    coordinate Cord
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }

  model Nazioni {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    siglaNazionale String
    codiceBelfiore String
    denominazioneNazionale String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
  }
// ***** Fine dataModel *****


